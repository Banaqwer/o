     1863,1893,1923,1954,1986,2017,2049,2080,2111,2141,2171,2201,2230,2260,2291,2322,2353,2385,2417,2448,2479,2509,2539,2568,2598,2628,2658,2689,2721,2753,
     2784,2815,2846,2876,2906,2936,2965,2995,3026,3057,3089,3120,3152,3183,3214,3244,3273,3303,3333,3363,3394,3425,3456,3488,3519,3550,3581,3611,3641,3671,
     3700,3730,3761,3792,3824,3855,3887,3918,3949,3979,4008,4038,4068,4098,4129,4160,4191,4223,4254,4286,4316,4346,4376)


// =============================================================================
// ■ DATE → TABLE INDEX HELPER
// =============================================================================
// Convert the current bar's timestamp to a day index.
// EPOCH_DAY_MS = 2015-01-01 00:00 UTC = 1420070400000 (Unix ms)

float EPOCH_DAY_MS_F = 1420070400000.0
float MS_DAY_F       = 86400000.0

// Day index for the current bar (integer; na if outside table range)
// Index range: 0 (= 2015-01-01) … 4382 (= 2026-12-31), inclusive → 4383 entries total
int barDayIdx = int((time - EPOCH_DAY_MS_F) / MS_DAY_F)
bool inTable  = barDayIdx >= 0 and barDayIdx <= 4382

// Lookup helpers — dayIdx must be in [0, 4382] when tableOk is true

// Return Moon sign (0-11) for a given day index, or -1 if out of range.
// Caller guarantees dayIdx ∈ [0, 4382] when tableOk == true.
moonSignLookup(int dayIdx, bool tableOk) =>
    if not tableOk or dayIdx < 0 or dayIdx > 4382
        -1
    else if dayIdx < 2192
        array.get(MOON_SIGN_A, dayIdx)
    else
        array.get(MOON_SIGN_B, dayIdx - 2192)

// Binary-search: is dayIdx present in a sorted array of phase dates?
_inPhaseArr(int[] arr, int dayIdx) =>
    int lo = 0
    int hi = array.size(arr) - 1
    bool found = false
    while lo <= hi
        int mid = (lo + hi) / 2
        int v   = array.get(arr, mid)
        if v == dayIdx
            found := true
            lo    := hi + 1
        else if v < dayIdx
            lo := mid + 1
        else
            hi := mid - 1
    found

// Find the largest index in arr where arr[idx] <= dayIdx (floor search)
_phaseFloorIdx(int[] arr, int dayIdx) =>
    int lo = 0
    int hi = array.size(arr) - 1
    int best = 0
    while lo <= hi
        int mid = (lo + hi) / 2
        if array.get(arr, mid) <= dayIdx
            best := mid
            lo   := mid + 1
        else
            hi   := mid - 1
    best


// =============================================================================
// ■ ASTRONOMICAL LOOKUPS  (exact — no orbital approximation)
// =============================================================================

// ── Moon sign and derived properties
int   mSignIdx   = moonSignLookup(barDayIdx, inTable)  // -1 if out of range
int   mElem      = mSignIdx >= 0 ? mSignIdx % 4 : -1   // 0=Fire 1=Earth 2=Air 3=Water
int   mQual      = mSignIdx >= 0 ? mSignIdx % 3 : -1   // 0=Card 1=Fixed 2=Mutable
bool  isMutableMoon = mQual == 2

// ── Lunar phase detection
bool isNewMoon  = inTable and _inPhaseArr(PHASE_NM, barDayIdx)
bool isFirstQ   = inTable and _inPhaseArr(PHASE_FQ, barDayIdx)
bool isFullMoon = inTable and _inPhaseArr(PHASE_FM, barDayIdx)
bool isLastQ    = inTable and _inPhaseArr(PHASE_LQ, barDayIdx)
bool isPhaseDay = isNewMoon or isFirstQ or isFullMoon or isLastQ

// ── Solar Time Window (S3, S4): day when Sun makes a 16-aspect to an outer planet
bool inSolarWin = inTable and _inPhaseArr(SOLAR_WIN, barDayIdx)

// ── Sun-Neptune aspect day (S7)
bool sunNepAsp  = inTable and _inPhaseArr(SUN_NEP, barDayIdx)

// ── Lunation Duad Quality tracking (Strategy 1)
// PHASE_NM_Q[i] = sunDuadQ * 3 + moonDuadQ  for the i-th New Moon
// duadQMatch if sunDuadQ == moonDuadQ  ↔  code ∈ {0, 4, 8}
// Use _phaseFloorIdx to find the last New Moon on or before this bar
int nmQualCode = inTable ? array.get(PHASE_NM_Q, _phaseFloorIdx(PHASE_NM, barDayIdx)) : -1

bool duadQMatch = nmQualCode >= 0 and (nmQualCode == 0 or nmQualCode == 4 or nmQualCode == 8)
int  nmSunDuadQ  = nmQualCode >= 0 ? nmQualCode / 3 : 0   // Sun's duad quality at last New Moon
int  nmMoonDuadQ = nmQualCode >= 0 ? nmQualCode % 3 : 0   // Moon's duad quality at last New Moon

// ── Lunar Time Window (S4): Moon-outer-planet aspects several times per month
// Daily approximation: phase days and their ±1-day neighbours; also solar-window days
// Upper-bound guard: only check barDayIdx+1 when it is still within the table
bool inLunarWin = isPhaseDay or
                  (inTable and barDayIdx > 0    and _inPhaseArr(PHASE_NM, barDayIdx - 1)) or
                  (inTable and barDayIdx < 4382 and _inPhaseArr(PHASE_NM, barDayIdx + 1)) or
                  (inTable and barDayIdx > 0    and _inPhaseArr(PHASE_FM, barDayIdx - 1)) or
                  (inTable and barDayIdx < 4382 and _inPhaseArr(PHASE_FM, barDayIdx + 1)) or
                  (inTable and _inPhaseArr(SOLAR_WIN, barDayIdx))


// =============================================================================
// ■ CORE PRICE-ACTION
// =============================================================================

float pivH  = ta.pivothigh(high, i_pivN, i_pivN)
float pivL  = ta.pivotlow (low,  i_pivN, i_pivN)
bool  hasPH = not na(pivH)
bool  hasPL = not na(pivL)

bool nBarHigh = high > ta.highest(high[1], i_pivN)
bool nBarLow  = low  < ta.lowest (low[1],  i_pivN)

var float lpH    = na
var float lpL    = na
var int   lpHBar = na
var int   lpLBar = na
var float pp2H   = na
var float pp2L   = na

if hasPH
    pp2H   := lpH
    lpH    := pivH
    lpHBar := bar_index - i_pivN

if hasPL
    pp2L   := lpL
    lpL    := pivL
    lpLBar := bar_index - i_pivN

float swRange = (not na(lpH) and not na(lpL)) ? math.abs(lpH - lpL) : na

float pbH = math.max(open[1], close[1])
float pbL = math.min(open[1], close[1])

bool bearEngulf = open > pbH and close < pbL
bool bullEngulf = open < pbL and close > pbH


// =============================================================================
// ■ S3: SOLAR TREND INDICATOR  (Lessons 7-9)  [PRIMARY DIRECTION FILTER]
// =============================================================================
// Solar Time Window days are computed from exact Sun-outer-planet aspect dates
// (Uranus, Neptune, Pluto) using the full 16-aspect set.
// Confirmed pivots on those days become the trend's S/R levels.

var float sRes    = na
var float sSup    = na
var string sTrend = "neutral"

if inSolarWin
    if hasPH
        sRes := pivH
    if hasPL
        sSup := pivL

if na(sRes) and not na(lpH)
    sRes := lpH
if na(sSup) and not na(lpL)
    sSup := lpL

if not na(sRes) and not na(sSup)
    if sTrend != "bear" and low < sSup
        sTrend := "bear"
        sSup   := not na(lpL) ? lpL : sSup
    else if sTrend != "bull" and high > sRes
        sTrend := "bull"
        sRes   := not na(lpH) ? lpH : sRes

bool sBull = sTrend == "bull"
bool sBear = sTrend == "bear"

bool  s3Long  = sBull and not sBull[1]
bool  s3Short = sBear and not sBear[1]

float s3Entry  = s3Long  ? sRes  : s3Short ? sSup  : na
float s3Stop   = s3Long  ? sSup  : s3Short ? sRes  : na
float s3Risk   = not na(s3Entry) and not na(s3Stop) ? math.abs(s3Entry - s3Stop) : na
float s3Target = s3Long  and not na(s3Risk) ? s3Entry + 2.0 * s3Risk :
                 s3Short and not na(s3Risk) ? s3Entry - 2.0 * s3Risk : na


// =============================================================================
// ■ S1: LUNATION CYCLE DUAD QUALITY  (Lessons 1-3)
// =============================================================================
// Uses exact phase dates and exact Sun/Moon duad quality at each New Moon.
// A "match" (duadQMatch) means Sun-duad quality == Moon-duad quality at last NM.
// Strategy: when 3+ consecutive NMs share the same duad quality →
//   derive bias from prior period's price direction → trade on engulfing patterns.

var int    lq_currQ  = -1
var int    lq_run    = 0
var float  lq_start  = na
var string lq_bias   = "none"

if isNewMoon
    if duadQMatch
        int tQ = nmSunDuadQ
        if tQ == lq_currQ
            lq_run := lq_run + 1
        else
            if not na(lq_start) and lq_currQ >= 0
                lq_bias := close > lq_start ? "long" : "short"
            lq_currQ := tQ
            lq_run   := 1
            lq_start := close
    else
        lq_run := 0

bool lq_active = lq_run >= 3 and lq_bias != "none"

bool  s1Long  = lq_active and lq_bias == "long"  and nBarLow  and bullEngulf
bool  s1Short = lq_active and lq_bias == "short" and nBarHigh and bearEngulf

float s1Entry  = s1Long  ? pbH + syminfo.mintick : s1Short ? pbL - syminfo.mintick : na
float s1Stop   = s1Long  ? low  - syminfo.mintick : s1Short ? high + syminfo.mintick : na
float s1Risk   = not na(s1Entry) and not na(s1Stop) ? math.abs(s1Entry - s1Stop) : na
float s1Target = s1Long  and not na(s1Risk) ? s1Entry + 2.0 * s1Risk :
                 s1Short and not na(s1Risk) ? s1Entry - 2.0 * s1Risk : na


// =============================================================================
// ■ S2: THE 8TH WAY / ASPECT FLOW  (Lessons 4-6)
// =============================================================================
// Retracement reaching Aspect #7 (58.33%) but not #8 (66.67%) → trend intact.
// This strategy is purely price-based — no planetary lookup needed.

float ASPECT_7_RATIO        = 210.0 / 360.0
float ASPECT_8_RATIO        = 240.0 / 360.0
float RETRACEMENT_TOLERANCE = 0.02

bool  s2Short = false
bool  s2Long  = false
float s2Entry  = na
float s2Stop   = na
float s2Target = na

if not na(swRange) and swRange > 0.0
    if not na(lpHBar) and not na(lpLBar) and lpLBar > lpHBar
        float retUp = (close - lpL) / swRange
        if retUp >= (ASPECT_7_RATIO - RETRACEMENT_TOLERANCE) and retUp < ASPECT_8_RATIO and nBarHigh
            s2Short  := true
            s2Entry   := high[1]
            s2Stop    := high + syminfo.mintick
            float r2  = math.abs(s2Stop - s2Entry)
            s2Target  := s2Entry - r2

    if not na(lpHBar) and not na(lpLBar) and lpHBar > lpLBar
        float retDown = (lpH - close) / swRange
        if retDown >= (ASPECT_7_RATIO - RETRACEMENT_TOLERANCE) and retDown < ASPECT_8_RATIO and nBarLow
            s2Long   := true
            s2Entry   := low[1]
            s2Stop    := low - syminfo.mintick
            float r2  = math.abs(s2Entry - s2Stop)
            s2Target  := s2Entry + r2


// =============================================================================
// ■ S4: LUNAR TREND CONFIRMATION  (Lessons 11-12)
// =============================================================================
// Exact Moon-outer-planet aspect windows require 15-min intraday data.
// On daily bars: use exact phase days and solar-window adjacent days as proxy.

bool  s4Short = false
bool  s4Long  = false
float s4Entry  = na
float s4Stop   = na
float s4Target = na

if inLunarWin
    if sBear and close < low[1]
        s4Short  := true
        s4Entry   := low[1]
        s4Stop    := high + syminfo.mintick
        float r4  = math.abs(s4Stop - s4Entry)
        s4Target  := s4Entry - r4
    else if sBull and close > high[1]
        s4Long   := true
        s4Entry   := high[1]
        s4Stop    := low - syminfo.mintick
        float r4  = math.abs(s4Entry - s4Stop)
        s4Target  := s4Entry + r4


// =============================================================================
// ■ S5: ELEMENTAL & QUALITY CONNECTION  (Lessons 15-16)
// =============================================================================
// Uses exact Moon element/quality (derived from exact Moon sign lookup).
// Bearish/bullish engulfing at N-bar pivot where current extreme is weaker
// than the prior pivot formed when Moon was in the same element or quality.

var float lhE0 = na
var float lhE1 = na
var float lhE2 = na
var float lhE3 = na
var float llE0 = na
var float llE1 = na
var float llE2 = na
var float llE3 = na

var float lhQ0 = na
var float lhQ1 = na
var float lhQ2 = na
var float llQ0 = na
var float llQ1 = na
var float llQ2 = na

if hasPH and mElem >= 0
    if mElem == 0
        lhE0 := pivH
    else if mElem == 1
        lhE1 := pivH
    else if mElem == 2
        lhE2 := pivH
    else
        lhE3 := pivH

    if mQual == 0
        lhQ0 := pivH
    else if mQual == 1
        lhQ1 := pivH
    else if mQual == 2
        lhQ2 := pivH

if hasPL and mElem >= 0
    if mElem == 0
        llE0 := pivL
    else if mElem == 1
        llE1 := pivL
    else if mElem == 2
        llE2 := pivL
    else
        llE3 := pivL

    if mQual == 0
        llQ0 := pivL
    else if mQual == 1
        llQ1 := pivL
    else if mQual == 2
        llQ2 := pivL

// When mElem or mQual is -1 (out of table range) return na so no signal fires
float priorHE = mElem < 0 ? na : mElem == 0 ? lhE0 : mElem == 1 ? lhE1 : mElem == 2 ? lhE2 : lhE3
float priorLE = mElem < 0 ? na : mElem == 0 ? llE0 : mElem == 1 ? llE1 : mElem == 2 ? llE2 : llE3
float priorHQ = mQual < 0 ? na : mQual == 0 ? lhQ0 : mQual == 1 ? lhQ1 : lhQ2
float priorLQ = mQual < 0 ? na : mQual == 0 ? llQ0 : mQual == 1 ? llQ1 : llQ2

bool  s5Short = nBarHigh and bearEngulf and ((not na(priorHE) and high < priorHE) or (not na(priorHQ) and high < priorHQ))
bool  s5Long  = nBarLow  and bullEngulf and ((not na(priorLE) and low  > priorLE) or (not na(priorLQ) and low  > priorLQ))

float s5Entry  = s5Short ? pbL - syminfo.mintick : s5Long ? pbH + syminfo.mintick : na
float s5Stop   = s5Short ? high + syminfo.mintick : s5Long ? low  - syminfo.mintick : na
float s5Risk   = not na(s5Entry) and not na(s5Stop) ? math.abs(s5Entry - s5Stop) : na
float s5Target = s5Short and not na(s5Risk) ? s5Entry - 2.0 * s5Risk :
                 s5Long  and not na(s5Risk) ? s5Entry + 2.0 * s5Risk : na


// =============================================================================
// ■ S6: GOLDEN RATIO TURNING POINTS  (Lessons 17-18)
// =============================================================================
// Purely price-based (bar counts × φ).  No planetary data needed.

float PHI                   = 1.618033988749895
float DEFAULT_SWING_PCT     = 0.02
float DEFAULT_SWING_PCT_LT  = 0.03
float DIVERGENCE_STOP_BUF   = 0.02
float AGG_STOP_BUF_LONG     = 0.98
float AGG_STOP_BUF_SHORT    = 1.02
float AGG_TARGET_BUF_LONG   = 1.04
float AGG_TARGET_BUF_SHORT  = 0.96

var int  grProjBar = na
var bool grWasHigh = false

if hasPH and not na(lpLBar)
    int nb = (bar_index - i_pivN) - lpLBar
    if nb >= 2
        int midB  = lpLBar + nb / 2
        grProjBar := midB + int(float(nb) * PHI)
        grWasHigh := true

if hasPL and not na(lpHBar)
    int nb = (bar_index - i_pivN) - lpHBar
    if nb >= 2
        int midB  = lpHBar + nb / 2
        grProjBar := midB + int(float(nb) * PHI)
        grWasHigh := false

bool nearGolden = not na(grProjBar) and math.abs(float(bar_index) - float(grProjBar)) <= 1.0

bool  s6Short = false
bool  s6Long  = false
float s6Entry  = na
float s6Stop   = na
float s6Target = na

if nearGolden
    float swR6 = not na(swRange) ? swRange : close * DEFAULT_SWING_PCT
    if hasPH
        s6Short  := true
        s6Entry   := high - syminfo.mintick
        s6Stop    := high + syminfo.mintick
        s6Target  := s6Entry - swR6
    else if hasPL
        s6Long   := true
        s6Entry   := low  + syminfo.mintick
        s6Stop    := low  - syminfo.mintick
        s6Target  := s6Entry + swR6


// =============================================================================
// ■ S7: SUN-NEPTUNE LONG-TERM SIGNAL  (Lesson 20)
// =============================================================================
// Uses exact Sun-Neptune aspect dates (pre-computed at 30-degree intervals).
// Both primary symbol AND sector ETF must confirm a 3-bar pivot.

[secHigh, secLow] = request.security(i_sector, timeframe.period,
                     [high, low], lookahead = barmerge.lookahead_off)

float secPivH  = ta.pivothigh(secHigh, i_pivN, i_pivN)
float secPivL  = ta.pivotlow (secLow,  i_pivN, i_pivN)
bool  secHasPH = not na(secPivH)
bool  secHasPL = not na(secPivL)

bool  s7Short = false
bool  s7Long  = false
float s7Entry  = na
float s7Stop   = na
float s7Target = na

if sunNepAsp
    float swR7 = not na(swRange) ? swRange : close * DEFAULT_SWING_PCT_LT
    if hasPH and secHasPH
        s7Short  := true
        s7Entry   := high - syminfo.mintick
        s7Stop    := high + syminfo.mintick
        s7Target  := s7Entry - 3.0 * swR7
    else if hasPL and secHasPL
        s7Long   := true
        s7Entry   := low  + syminfo.mintick
        s7Stop    := low  - syminfo.mintick
        s7Target  := s7Entry + 3.0 * swR7


// =============================================================================
// ■ S8: THE MUTABLE FACTOR  (Lessons 21-23)
// =============================================================================
// Uses exact Moon sign lookup → Mutable (Gemini/Virgo/Sagittarius/Pisces).
// Engulfing pattern at N-bar pivot.  Split targets (1× and 2× risk).

bool  s8Short   = false
bool  s8Long    = false
float s8Entry   = na
float s8Stop    = na
float s8Target1 = na
float s8Target2 = na

if isMutableMoon
    if nBarHigh and bearEngulf
        s8Short   := true
        s8Entry    := pbL - syminfo.mintick
        s8Stop     := high + syminfo.mintick
        float r8   = math.abs(s8Stop - s8Entry)
        s8Target1  := s8Entry - r8
        s8Target2  := s8Entry - 2.0 * r8
    else if nBarLow and bullEngulf
        s8Long    := true
        s8Entry    := pbH + syminfo.mintick
        s8Stop     := low  - syminfo.mintick
        float r8   = math.abs(s8Entry - s8Stop)
        s8Target1  := s8Entry + r8
        s8Target2  := s8Entry + 2.0 * r8

float s8Target = s8Short ? s8Target2 : s8Long ? s8Target2 : na


// =============================================================================
// ■ S9: LUNAR PHASE DUAD TURN DATES  (Lessons 24-25)
// =============================================================================
// Confirmed 3-bar pivots on exact phase days become major S/R levels.

var float lp9PH  = na
var float lp9PL  = na
var string lp9Tr = "neutral"

if isPhaseDay
    if hasPH
        lp9PH := pivH
    if hasPL
        lp9PL := pivL

if na(lp9PH) and not na(lpH)
    lp9PH := lpH
if na(lp9PL) and not na(lpL)
    lp9PL := lpL

bool  s9Short = false
bool  s9Long  = false
float s9Entry  = na
float s9Stop   = na
float s9Target = na

if not na(lp9PH) and not na(lp9PL)
    if lp9Tr != "bear" and low < lp9PL
        s9Short  := true
        lp9Tr    := "bear"
        s9Entry   := lp9PL
        s9Stop    := lp9PH
        float r9  = math.abs(s9Stop - s9Entry)
        s9Target  := s9Entry - r9
        lp9PL     := not na(lpL) ? lpL : lp9PL
    else if lp9Tr != "bull" and high > lp9PH
        s9Long   := true
        lp9Tr    := "bull"
        s9Entry   := lp9PH
        s9Stop    := lp9PL
        float r9  = math.abs(s9Entry - s9Stop)
        s9Target  := s9Entry + r9
        lp9PH     := not na(lpH) ? lpH : lp9PH


// =============================================================================
// ■ S10: INTERMARKET DIVERGENCE  (Lessons 26-27)
// =============================================================================
// Purely price-based.  Compares primary symbol with Symbol 2.

[s2H, s2L] = request.security(i_sym2, timeframe.period,
              [high, low], lookahead = barmerge.lookahead_off)

float sym2PivH = ta.pivothigh(s2H, i_pivN, i_pivN)
float sym2PivL = ta.pivotlow (s2L, i_pivN, i_pivN)

var float s2lpH  = na
var float s2lpL  = na
var float s2pp2H = na
var float s2pp2L = na

if not na(sym2PivH)
    s2pp2H := s2lpH
    s2lpH  := sym2PivH

if not na(sym2PivL)
    s2pp2L := s2lpL
    s2lpL  := sym2PivL

bool negDiv = hasPH and not na(pp2H) and not na(s2lpH) and not na(s2pp2H) and
              pivH > pp2H and sym2PivH < s2pp2H

bool posDiv = hasPL and not na(pp2L) and not na(s2lpL) and not na(s2pp2L) and
              pivL < pp2L and sym2PivL > s2pp2L

var bool pendNeg = false
var bool pendPos = false

if negDiv
    pendNeg := true
if posDiv
    pendPos := true

bool confNeg = pendNeg and low < low[1]   and s2L < s2L[1]
bool confPos = pendPos and high > high[1] and s2H > s2H[1]

if confNeg
    pendNeg := false
if confPos
    pendPos := false

bool  s10Short = confNeg
bool  s10Long  = confPos

float s10Entry  = s10Short ? low  : s10Long  ? high : na
float s10Stop   = s10Short ? (not na(lpH) ? lpH + syminfo.mintick : high * (1.0 + DIVERGENCE_STOP_BUF)) :
                  s10Long  ? (not na(lpL) ? lpL  - syminfo.mintick : low  * (1.0 - DIVERGENCE_STOP_BUF)) : na
float s10Risk   = not na(s10Entry) and not na(s10Stop) ? math.abs(s10Entry - s10Stop) : na
float s10Target = s10Short and not na(s10Risk) ? s10Entry - s10Risk :
                  s10Long  and not na(s10Risk) ? s10Entry + s10Risk : na


// =============================================================================
// ■ SIGNAL AGGREGATION & CONFIDENCE SCORING
// =============================================================================

int longConf  = (s1Long  ? 1 : 0) + (s2Long  ? 1 : 0) + (s3Long  ? 1 : 0) + (s4Long  ? 1 : 0) + (s5Long  ? 1 : 0) + (s6Long  ? 1 : 0) + (s7Long  ? 1 : 0) + (s8Long  ? 1 : 0) + (s9Long  ? 1 : 0) + (s10Long ? 1 : 0)

int shortConf = (s1Short  ? 1 : 0) + (s2Short  ? 1 : 0) + (s3Short  ? 1 : 0) + (s4Short  ? 1 : 0) + (s5Short  ? 1 : 0) + (s6Short  ? 1 : 0) + (s7Short  ? 1 : 0) + (s8Short  ? 1 : 0) + (s9Short  ? 1 : 0) + (s10Short ? 1 : 0)

bool rawLong  = longConf  >= i_minConf
bool rawShort = shortConf >= i_minConf

bool filtLong  = rawLong  and (not i_solarFilt or sBull)
bool filtShort = rawShort and (not i_solarFilt or sBear)

float aggLE = filtLong  ? (s1Long  ? s1Entry  : s2Long  ? s2Entry  : s3Long  ? s3Entry  : s4Long  ? s4Entry  : s5Long  ? s5Entry  : s6Long  ? s6Entry  : s7Long  ? s7Entry  : s8Long  ? s8Entry  : s9Long  ? s9Entry  : s10Long ? s10Entry : close) : na

float aggLS = filtLong  ? (s1Long  ? s1Stop   : s2Long  ? s2Stop   : s3Long  ? s3Stop   : s4Long  ? s4Stop   : s5Long  ? s5Stop   : s6Long  ? s6Stop   : s7Long  ? s7Stop   : s8Long  ? s8Stop   : s9Long  ? s9Stop   : s10Long ? s10Stop  : close * AGG_STOP_BUF_LONG) : na

float aggLT = filtLong  ? (s1Long  ? s1Target : s2Long  ? s2Target : s3Long  ? s3Target : s4Long  ? s4Target : s5Long  ? s5Target : s6Long  ? s6Target : s7Long  ? s7Target : s8Long  ? s8Target : s9Long  ? s9Target : s10Long ? s10Target : close * AGG_TARGET_BUF_LONG) : na

float aggSE = filtShort ? (s1Short  ? s1Entry  : s2Short  ? s2Entry  : s3Short  ? s3Entry  : s4Short  ? s4Entry  : s5Short  ? s5Entry  : s6Short  ? s6Entry  : s7Short  ? s7Entry  : s8Short  ? s8Entry  : s9Short  ? s9Entry  : s10Short ? s10Entry : close) : na

float aggSS = filtShort ? (s1Short  ? s1Stop   : s2Short  ? s2Stop   : s3Short  ? s3Stop   : s4Short  ? s4Stop   : s5Short  ? s5Stop   : s6Short  ? s6Stop   : s7Short  ? s7Stop   : s8Short  ? s8Stop   : s9Short  ? s9Stop   : s10Short ? s10Stop  : close * AGG_STOP_BUF_SHORT) : na

float aggST = filtShort ? (s1Short  ? s1Target : s2Short  ? s2Target : s3Short  ? s3Target : s4Short  ? s4Target : s5Short  ? s5Target : s6Short  ? s6Target : s7Short  ? s7Target : s8Short  ? s8Target : s9Short  ? s9Target : s10Short ? s10Target : close * AGG_TARGET_BUF_SHORT) : na

float lRisk   = not na(aggLE) and not na(aggLS) ? math.abs(aggLE - aggLS)  : na
float lReward = not na(aggLE) and not na(aggLT) ? math.abs(aggLT - aggLE)  : na
float lRR     = not na(lRisk) and lRisk > 0.0 and not na(lReward) ? lReward / lRisk : 0.0

float sRisk   = not na(aggSE) and not na(aggSS) ? math.abs(aggSE - aggSS)  : na
float sReward = not na(aggSE) and not na(aggST) ? math.abs(aggSE - aggST)  : na
float sRR     = not na(sRisk) and sRisk > 0.0 and not na(sReward) ? sReward / sRisk : 0.0

bool finalLong  = filtLong  and lRR >= i_minRR
bool finalShort = filtShort and sRR >= i_minRR


// =============================================================================
// ■ VISUAL OUTPUT
// =============================================================================

bgcolor(i_showSolar   and sBull         ? color.new(color.green,  90) :
        i_showSolar   and sBear         ? color.new(color.red,    90) : na,
        title = "Solar Trend Background")

bgcolor(i_showMutable and isMutableMoon ? color.new(color.purple, 88) : na,
        title = "Mutable Moon Period")

bgcolor(i_showSolar   and inSolarWin    ? color.new(color.yellow, 94) : na,
        title = "Solar Time Window")

plotshape(i_showPiv and hasPH,
          title = "Confirmed Pivot High", style = shape.triangledown,
          location = location.abovebar, color = color.new(color.orange, 10), size = size.small)

plotshape(i_showPiv and hasPL,
          title = "Confirmed Pivot Low", style = shape.triangleup,
          location = location.belowbar, color = color.new(color.teal, 10), size = size.small)

string lunarTxt = isNewMoon  ? "🌑 NM" :
                  isFirstQ   ? "🌓 1Q" :
                  isFullMoon ? "🌕 FM" :
                  isLastQ    ? "🌗 3Q" : ""

if i_showLunar and isPhaseDay
    label.new(bar_index, high, text = lunarTxt,
              color = color.new(color.navy, 50), textcolor = color.white,
              style = label.style_label_down, size = size.small, yloc = yloc.abovebar)

var line lineRes = na
var line lineSup = na

if i_showSolar and not na(sRes)
    if not na(lineRes)
        line.delete(lineRes)
    lineRes := line.new(bar_index - 30, sRes, bar_index, sRes,
                        color = color.new(color.red, 30), style = line.style_dashed, width = 1)
if i_showSolar and not na(sSup)
    if not na(lineSup)
        line.delete(lineSup)
    lineSup := line.new(bar_index - 30, sSup, bar_index, sSup,
                        color = color.new(color.green, 30), style = line.style_dashed, width = 1)

var line lp9LineH = na
var line lp9LineL = na

if i_showLunar and not na(lp9PH)
    if not na(lp9LineH)
        line.delete(lp9LineH)
    lp9LineH := line.new(bar_index - 15, lp9PH, bar_index, lp9PH,
                         color = color.new(color.blue, 40), style = line.style_dotted, width = 2)
if i_showLunar and not na(lp9PL)
    if not na(lp9LineL)
        line.delete(lp9LineL)
    lp9LineL := line.new(bar_index - 15, lp9PL, bar_index, lp9PL,
                         color = color.new(color.blue, 40), style = line.style_dotted, width = 2)

float aspBase = not na(lpL) and not na(swRange) ? lpL : na

plot(i_showAsp ? aspBase + swRange * (30.0  / 360.0) : na, color = color.new(color.gray, 72), linewidth = 1, title = "Asp #1  (30°)")
plot(i_showAsp ? aspBase + swRange * (60.0  / 360.0) : na, color = color.new(color.gray, 72), linewidth = 1, title = "Asp #2  (60°)")
plot(i_showAsp ? aspBase + swRange * (90.0  / 360.0) : na, color = color.new(color.gray, 72), linewidth = 1, title = "Asp #3  (90°)")
plot(i_showAsp ? aspBase + swRange * (120.0 / 360.0) : na, color = color.new(color.gray, 72), linewidth = 1, title = "Asp #4 (120°)")
plot(i_showAsp ? aspBase + swRange * (150.0 / 360.0) : na, color = color.new(color.gray, 65), linewidth = 1, title = "Asp #5 (150°)")
plot(i_showAsp ? aspBase + swRange * (180.0 / 360.0) : na, color = color.new(color.gray, 55), linewidth = 2, title = "Asp #6 (180° – 50%)")
plot(i_showAsp ? aspBase + swRange * (210.0 / 360.0) : na, color = color.new(color.orange, 35), linewidth = 2, title = "Asp #7 (210° – 58%)")
plot(i_showAsp ? aspBase + swRange * (240.0 / 360.0) : na, color = color.new(color.red, 35),    linewidth = 2, title = "Asp #8 (240° – 67%)")
plot(i_showAsp ? aspBase + swRange * (270.0 / 360.0) : na, color = color.new(color.gray, 65), linewidth = 1, title = "Asp #9 (270°)")
plot(i_showAsp ? aspBase + swRange * (300.0 / 360.0) : na, color = color.new(color.gray, 65), linewidth = 1, title = "Asp #10 (300°)")
plot(i_showAsp ? aspBase + swRange * (330.0 / 360.0) : na, color = color.new(color.gray, 65), linewidth = 1, title = "Asp #11 (330°)")

var line grArrow = na
if i_showGolden and not na(grProjBar) and grProjBar > bar_index
    if not na(grArrow)
        line.delete(grArrow)
    grArrow := line.new(bar_index, close, grProjBar, close,
                        color = color.new(color.yellow, 30),
                        style = line.style_arrow_right, width = 1)

if i_showGolden and nearGolden
    label.new(bar_index, low, text = "φ GR",
              color = color.new(color.yellow, 20), textcolor = color.black,
              style = label.style_label_up, size = size.tiny, yloc = yloc.belowbar)

if i_showSigs and sunNepAsp
    label.new(bar_index, high, text = "☉♆",
              color = color.new(color.aqua, 45), textcolor = color.black,
              style = label.style_label_down, size = size.tiny, yloc = yloc.abovebar)

if i_showDiv and negDiv
    label.new(bar_index - i_pivN, high, text = "NEG DIV ▼",
              color = color.new(color.orange, 25), textcolor = color.black,
              style = label.style_label_down, size = size.small)

if i_showDiv and posDiv
    label.new(bar_index - i_pivN, low, text = "POS DIV ▲",
              color = color.new(color.teal, 25), textcolor = color.black,
              style = label.style_label_up, size = size.small)

if i_showSigs and s8Short and not na(s8Target1) and not na(s8Target2)
    line.new(bar_index, s8Target1, bar_index + 5, s8Target1,
             color = color.new(color.orange, 30), style = line.style_dotted, width = 1)
    line.new(bar_index, s8Target2, bar_index + 5, s8Target2,
             color = color.new(color.red, 30), style = line.style_dotted, width = 2)

if i_showSigs and s8Long and not na(s8Target1) and not na(s8Target2)
    line.new(bar_index, s8Target1, bar_index + 5, s8Target1,
             color = color.new(color.lime, 30), style = line.style_dotted, width = 1)
    line.new(bar_index, s8Target2, bar_index + 5, s8Target2,
             color = color.new(color.green, 30), style = line.style_dotted, width = 2)

if i_showSigs and finalLong
    string lTxt = "▲  LONG\nConf: " + str.tostring(longConf) + "/10\n" +
                  "R:R  " + str.tostring(math.round(lRR, 1)) + ":1"
    label.new(bar_index, low, text = lTxt,
              color = color.new(color.lime, 10), textcolor = color.black,
              style = label.style_label_up, size = size.normal, yloc = yloc.belowbar)
    if not na(aggLE) and not na(aggLT) and not na(aggLS)
        box.new(bar_index, aggLT, bar_index + 5, aggLS,
                bgcolor = color.new(color.lime, 80), border_color = color.lime, border_width = 1)

if i_showSigs and finalShort
    string sTxt = "▼  SHORT\nConf: " + str.tostring(shortConf) + "/10\n" +
                  "R:R  " + str.tostring(math.round(sRR, 1)) + ":1"
    label.new(bar_index, high, text = sTxt,
              color = color.new(color.red, 10), textcolor = color.white,
              style = label.style_label_down, size = size.normal, yloc = yloc.abovebar)
    if not na(aggSE) and not na(aggST) and not na(aggSS)
        box.new(bar_index, aggSS, bar_index + 5, aggST,
                bgcolor = color.new(color.red, 80), border_color = color.red, border_width = 1)

plot(longConf,  title = "Long Confidence  (0-10)", color = color.lime, linewidth = 2,
     display = display.data_window)
plot(shortConf, title = "Short Confidence (0-10)", color = color.red,  linewidth = 2,
     display = display.data_window)


// =============================================================================
// ■ STRATEGY SUMMARY TABLE
// =============================================================================

var table tbl = table.new(position.top_right, 3, 14,
                           bgcolor = color.new(color.black, 65),
                           border_width = 1, border_color = color.new(color.gray, 50))

if barstate.islast and i_showTable
    table.cell(tbl, 0,  0, "Strategy",     text_color = color.white,  bgcolor = color.new(color.navy, 40), text_size = size.small)
    table.cell(tbl, 1,  0, "Long ▲",       text_color = color.lime,   bgcolor = color.new(color.navy, 40), text_size = size.small)
    table.cell(tbl, 2,  0, "Short ▼",      text_color = color.red,    bgcolor = color.new(color.navy, 40), text_size = size.small)

    table.cell(tbl, 0,  1, "1  Lunation Duad",   text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  1, s1Long  ? "●" : "○",  text_color = s1Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  1, s1Short ? "●" : "○",  text_color = s1Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  2, "2  8th Way",          text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  2, s2Long  ? "●" : "○",  text_color = s2Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  2, s2Short ? "●" : "○",  text_color = s2Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  3, "3  Solar Trend",      text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  3, s3Long  ? "●" : "○",  text_color = s3Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  3, s3Short ? "●" : "○",  text_color = s3Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  4, "4  Lunar Trend",      text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  4, s4Long  ? "●" : "○",  text_color = s4Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  4, s4Short ? "●" : "○",  text_color = s4Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  5, "5  Elem/Qual",        text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  5, s5Long  ? "●" : "○",  text_color = s5Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  5, s5Short ? "●" : "○",  text_color = s5Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  6, "6  Golden Ratio",     text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  6, s6Long  ? "●" : "○",  text_color = s6Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  6, s6Short ? "●" : "○",  text_color = s6Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  7, "7  Sun-Neptune",      text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  7, s7Long  ? "●" : "○",  text_color = s7Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  7, s7Short ? "●" : "○",  text_color = s7Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  8, "8  Mutable Factor",   text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  8, s8Long  ? "●" : "○",  text_color = s8Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  8, s8Short ? "●" : "○",  text_color = s8Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0,  9, "9  Phase Duad",       text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1,  9, s9Long  ? "●" : "○",  text_color = s9Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2,  9, s9Short ? "●" : "○",  text_color = s9Short ? color.red  : color.gray, text_size = size.small)

    table.cell(tbl, 0, 10, "10 Intermarket Div",  text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1, 10, s10Long  ? "●" : "○", text_color = s10Long  ? color.lime : color.gray, text_size = size.small)
    table.cell(tbl, 2, 10, s10Short ? "●" : "○", text_color = s10Short ? color.red  : color.gray, text_size = size.small)

    string lAggStr = "▲ LONG  Conf:" + str.tostring(longConf)  + (finalLong  ? " ✓" : "")
    string sAggStr = "▼ SHORT Conf:" + str.tostring(shortConf) + (finalShort ? " ✓" : "")
    table.cell(tbl, 0, 11, "── AGGREGATED ──",
               text_color = color.yellow, bgcolor = color.new(color.navy, 60), text_size = size.tiny)
    table.cell(tbl, 1, 11, lAggStr,
               text_color = finalLong  ? color.lime : color.gray,
               bgcolor = color.new(color.navy, 60), text_size = size.tiny)
    table.cell(tbl, 2, 11, sAggStr,
               text_color = finalShort ? color.red  : color.gray,
               bgcolor = color.new(color.navy, 60), text_size = size.tiny)

    string moonSignStr = mSignIdx >= 0 ? str.tostring(mSignIdx) : "?"
    string mutStr      = isMutableMoon ? "  (Mutable)" : ""
    string stTxt       = "Solar: " + sTrend
    color  stCol       = sBull ? color.lime : sBear ? color.red : color.gray
    table.cell(tbl, 0, 12, stTxt,                 text_color = stCol,  text_size = size.tiny)
    table.cell(tbl, 1, 12, "Moon: " + moonSignStr + mutStr,
               text_color = isMutableMoon ? color.purple : color.white, text_size = size.tiny)
    table.cell(tbl, 2, 12, "Phase: " + (isPhaseDay ? lunarTxt : "—"),
               text_color = isPhaseDay ? color.yellow : color.white, text_size = size.tiny)

    string tableRange = inTable ? "Tables: 2015-2026 ✓" : "⚠ Outside table range"
    color  rangeCol   = inTable ? color.gray : color.orange
    table.cell(tbl, 0, 13, tableRange,
               text_color = rangeCol, text_size = size.tiny)
    table.cell(tbl, 1, 13,
               "MinConf=" + str.tostring(i_minConf) + "  MinRR=" + str.tostring(i_minRR),
               text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 2, 13,
               "PivN=" + str.tostring(i_pivN) + "  Solar=" + (i_solarFilt ? "ON" : "OFF"),
               text_color = color.gray, text_size = size.tiny)
