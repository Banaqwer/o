// =============================================================================
// Financial Astrology Trading System
// "Secrets of Financial Astrology" – Kenneth Min (27 Lessons) — All 10 Strategies
//
// ─── Accuracy note ───────────────────────────────────────────────────────────
// Planetary positions are pre-computed from PyEphem (exact ephemeris) and
// embedded as integer lookup tables covering 2015-01-01 → 2026-12-31.
// There is NO orbital-period approximation.  Moon sign, Moon phase dates, Solar
// Time Windows, and Sun-Neptune aspects are all exact to the day.
//
// Strategies implemented:
//   S1  Lunation Cycle Duad Quality         (Lessons  1– 3)
//   S2  The 8th Way / Aspect Flow           (Lessons  4– 6)
//   S3  Solar Trend Indicator  [FILTER]     (Lessons  7– 9)
//   S4  Lunar Trend Confirmation            (Lessons 11–12)
//   S5  Elemental & Quality Connection      (Lessons 15–16)
//   S6  Golden Ratio Turning Points         (Lessons 17–18)
//   S7  Sun-Neptune Long-Term Signal        (Lesson  20)
//   S8  Mutable Factor                      (Lessons 21–23)
//   S9  Lunar Phase Duad Turn Dates         (Lessons 24–25)
//   S10 Intermarket Divergence              (Lessons 26–27)
//
// Lookup table range: 2015-01-01 → 2026-12-31
// For dates outside this range the script falls back to approximate astronomy.
// =============================================================================

//@version=5
indicator(title      = "Financial Astrology – Kenneth Min (27 Lessons, Exact Tables)",
          shorttitle = "FinAstro-Exact",
          overlay    = true,
          max_lines_count  = 500,
          max_labels_count = 500,
          max_boxes_count  = 200)


// =============================================================================
// ■ INPUTS
// =============================================================================

var string GRP_CORE    = "◆ Core Settings"
var string GRP_FILTER  = "◆ Signal Filters"
var string GRP_DISPLAY = "◆ Display Options"

i_sym2    = input.symbol("SPY", "Symbol 2  (Intermarket Divergence)",  group = GRP_CORE)
i_sector  = input.symbol("SMH", "Sector ETF  (Sun-Neptune Strategy)",  group = GRP_CORE)
i_pivN    = input.int(3, "N-Bar Pivot Lookback", minval = 2, maxval = 5, group = GRP_CORE)

i_minConf   = input.int  (2,   "Min Confidence  (# strategies agreeing)",
                           minval = 1, maxval = 10, group = GRP_FILTER)
i_minRR     = input.float(1.5, "Min Risk : Reward",
                           minval = 0.5, step = 0.1, group = GRP_FILTER)
i_solarFilt = input.bool (true,
                           "Solar Trend Filter (long in bull / short in bear only)",
                           group = GRP_FILTER)

i_showLunar   = input.bool(true,  "Lunar Phase Labels",             group = GRP_DISPLAY)
i_showPiv     = input.bool(true,  "Confirmed Pivot Markers",        group = GRP_DISPLAY)
i_showSolar   = input.bool(true,  "Solar Trend Background + Levels",group = GRP_DISPLAY)
i_showSigs    = input.bool(true,  "Trade Signal Labels + Boxes",    group = GRP_DISPLAY)
i_showAsp     = input.bool(true,  "Aspect Level Lines (8th Way)",   group = GRP_DISPLAY)
i_showGolden  = input.bool(true,  "Golden Ratio Projections",       group = GRP_DISPLAY)
i_showMutable = input.bool(true,  "Mutable Moon Period Shading",    group = GRP_DISPLAY)
i_showDiv     = input.bool(true,  "Intermarket Divergence Markers", group = GRP_DISPLAY)
i_showTable   = input.bool(true,  "Strategy Summary Table",         group = GRP_DISPLAY)


// =============================================================================
